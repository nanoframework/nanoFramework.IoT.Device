        <dependency id="nanoFramework.System.Device.Model" version="2.0.0-preview.77" />
        <dependency id="nanoFramework.System.Diagnostics.Stopwatch" version="2.0.0-preview.77" />
        <dependency id="nanoFramework.UnitsNet.RelativeHumidity" version="5.77.0-preview.14" />
        <dependency id="nanoFramework.UnitsNet.Temperature" version="5.77.0-preview.14" />
      </group>
    </dependencies>
  </metadata>
  <files>
