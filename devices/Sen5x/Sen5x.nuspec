<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>nanoFramework.Iot.Device.Sen5x</id>
    <version>$version$</version>
    <title>nanoFramework.Iot.Device.Sen5x</title>
    <authors>nanoframework</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="file">LICENSE.md</license>
    <releaseNotes>
    </releaseNotes>
    <readme>docs\README.md</readme>
    <developmentDependency>false</developmentDependency>
    <projectUrl>https://github.com/nanoframework/nanoFramework.IoT.Device</projectUrl>
    <icon>images\nf-logo.png</icon>
    <repository type="git" url="https://github.com/nanoframework/nanoFramework.IoT.Device" commit="$commit$" />
    <copyright>Copyright (c) .NET Foundation and Contributors</copyright>
    <description>This package contains a driver to communicate with the Sen5x via the UART interface.</description>
    <tags>nanoFramework C# csharp netnf Sen5x</tags>
    <dependencies>
      <group targetFramework=".NETnanoFramework1.0">
        <dependency id="nanoFramework.CoreLibrary" version="2.0.0-preview.52" />
        <dependency id="nanoFramework.System.Buffers.Binary.BinaryPrimitives" version="2.0.0-preview.77" />
        <dependency id="nanoFramework.System.Device.I2c" version="2.0.0-preview.12" />
        <dependency id="nanoFramework.UnitsNet.MassConcentration" version="5.77.0-preview.16" />
        <dependency id="nanoFramework.UnitsNet.RelativeHumidity" version="5.77.0-preview.16" />
        <dependency id="nanoFramework.UnitsNet.Temperature" version="5.77.0-preview.16" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\Iot.Device.Sen5x.*" target="lib\netnano1.0" />
    <file src="README.md" target="docs\" />
    <file src="..\..\assets\nf-logo.png" target="images" />
    <file src="..\..\LICENSE.md" target="" />
  </files>
</package>