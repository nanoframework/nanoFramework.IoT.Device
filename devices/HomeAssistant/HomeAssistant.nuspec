<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>nanoFramework.Iot.Device.HomeAssistant</id>
    <version>$version$</version>
    <title>nanoFramework.Iot.Device.HomeAssistant</title>
    <authors>nanoframework</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="file">LICENSE.md</license>
    <releaseNotes>
    </releaseNotes>
    <readme>docs\README.md</readme>
    <developmentDependency>false</developmentDependency>
    <projectUrl>https://github.com/nanoframework/nanoFramework.IoT.Device</projectUrl>
    <icon>images\nf-logo.png</icon>
    <repository type="git" url="https://github.com/nanoframework/nanoFramework.IoT.Device" commit="$commit$" />
    <copyright>Copyright (c) .NET Foundation and Contributors</copyright>
    <description>This package includes the .NET IoT Core binding Home Assistant for .NET nanoFramework C# projects.
    This allows integration with Home Assistant for IoT devices. Supports MQTT integration with Discovery Protocol.
    Creation of device entities and management of their states.</description>
    <summary>Iot.Device.HomeAssistant assembly for .NET nanoFramework C# projects</summary>
    <tags>nanoFramework C# csharp netmf netnf iot HomeAssistant</tags>
    <dependencies>
        <dependency id="nanoFramework.CoreLibrary" version="1.17.11" />
    		<dependency id="nanoFramework.M2Mqtt" version="5.1.217" />
        <dependency id="nanoFramework.M2Mqtt.Core" version="5.1.217" />
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\Iot.Device.HomeAssistant.dll" target="lib\Iot.Device.HomeAssistant.dll" />
    <file src="bin\Release\Iot.Device.HomeAssistant.pdb" target="lib\Iot.Device.HomeAssistant.pdb" />
    <file src="bin\Release\Iot.Device.HomeAssistant.pdbx" target="lib\Iot.Device.HomeAssistant.pdbx" />
    <file src="bin\Release\Iot.Device.HomeAssistant.pe" target="lib\Iot.Device.HomeAssistant.pe" />
    <file src="bin\Release\Iot.Device.HomeAssistant.xml" target="lib\Iot.Device.HomeAssistant.xml" />
    <file src="README.md" target="docs\" />
    <file src="..\..\assets\nf-logo.png" target="images" />
    <file src="..\..\LICENSE.md" target="" />
  </files>
</package>